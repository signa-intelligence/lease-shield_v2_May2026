import { createClientFromRequest } from 'npm:@base44/sdk@0.7.1';

const LETTER_WRITER_PROMPT = `You are a professional letter writer for rental disputes in Thailand.

Generate ONE professional, bilingual letter (English + Thai) based on the case details provided.

CRITICAL RULES:
1. Output ONLY valid JSON - no markdown, no explanations
2. English and Thai paragraphs must be matched 1:1
3. Use proper UTF-8 Thai characters (not HTML entities)
4. Keep it professional, neutral, and factual
5. 150-250 words in English (Thai should mirror)

OUTPUT FORMAT (strict JSON):
{
  "subject_en": "Request for Deposit Return",
  "subject_th": "ขอคืนเงินประกันการเช่า",
  "body_en": [
    "Dear [Landlord Name],",
    "I am writing to formally request...",
    "Thank you for your attention to this matter."
  ],
  "body_th": [
    "เรียนคุณ [ชื่อเจ้าของบ้าน]",
    "ข้าพเจ้าเขียนจดหมายฉบับนี้เพื่อขอ...",
    "ขอบคุณสำหรับความสนใจในเรื่องนี้"
  ]
}

EXAMPLE based on input:
Tenant: John, Landlord: Jane, Property: 123 Main St, Deposit: 10000 THB
{
  "subject_en": "Formal Request for Security Deposit Return",
  "subject_th": "ขอคืนเงินประกันการเช่าอย่างเป็นทางการ",
  "body_en": [
    "Dear Jane,",
    "I am writing to formally request the return of my security deposit of ฿10,000 for the property at 123 Main St.",
    "As per our lease agreement, I vacated the property on the agreed date and returned the keys in good condition.",
    "I would appreciate your prompt attention to this matter and look forward to receiving the deposit within 14 days.",
    "Please feel free to contact me if you need any clarification.",
    "Best regards,",
    "John"
  ],
  "body_th": [
    "เรียนคุณเจน",
    "ข้าพเจ้าเขียนจดหมายฉบับนี้เพื่อขอคืนเงินประกันการเช่าจำนวน ฿10,000 สำหรับทรัพย์สินที่ 123 Main St",
    "ตามสัญญาเช่า ข้าพเจ้าได้ย้ายออกจากทรัพย์สินในวันที่ตกลงกันและคืนกุญแจในสภาพดี",
    "ข้าพเจ้าจะขอบคุณหากท่านให้ความสนใจในเรื่องนี้อย่างรวดเร็วและหวังว่าจะได้รับเงินประกันภายใน 14 วัน",
    "โปรดติดต่อข้าพเจ้าหากท่านต้องการคำชี้แจงเพิ่มเติม",
    "ขอแสดงความนับถือ",
    "จอห์น"
  ]
}`;

// Simple HTML template for one letter
const getLetterHTML = (letter, caseInfo) => {
  const today = new Date().toISOString().split('T')[0];
  const year = new Date().getFullYear();
  
  return `<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>${letter.subject_en || 'Letter from Lease Shield'}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  @page { size: A4; margin: 20mm; }
  body {
    font-family: Inter, "Helvetica Neue", Arial, "Noto Sans Thai", sans-serif;
    line-height: 1.6;
    color: #111;
    max-width: 800px;
    margin: 0 auto;
    padding: 20mm;
  }
  .header {
    border-bottom: 3px solid #0C3B2E;
    padding-bottom: 15px;
    margin-bottom: 30px;
  }
  .logo-text {
    font-size: 24px;
    font-weight: 700;
    color: #0C3B2E;
    margin: 0;
  }
  .date {
    color: #666;
    font-size: 14px;
    margin-top: 5px;
  }
  h1 {
    color: #0C3B2E;
    font-size: 20px;
    margin: 20px 0 10px;
  }
  .thai {
    font-family: "Noto Sans Thai", "TH Sarabun New", sans-serif;
    color: #666;
    font-size: 16px;
    margin-bottom: 30px;
  }
  .section {
    margin: 15px 0;
  }
  .section p {
    margin: 10px 0;
  }
  .en {
    margin-bottom: 5px;
  }
  .th {
    font-family: "Noto Sans Thai", "TH Sarabun New", sans-serif;
    color: #555;
    font-size: 14px;
    margin-bottom: 15px;
  }
  .footer {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid #ddd;
    font-size: 12px;
    color: #999;
  }
</style>
</head>
<body>
  <div class="header">
    <div class="logo-text">LEASE SHIELD</div>
    <div class="date">Date: ${today}</div>
    ${caseInfo.caseId ? `<div class="date">Case: ${caseInfo.caseId.slice(0, 8)}</div>` : ''}
  </div>

  <h1>${letter.subject_en}</h1>
  <p class="thai">${letter.subject_th}</p>

  <div class="section">
    ${letter.body_en.map((para, i) => `
      <p class="en">${para}</p>
      ${letter.body_th[i] ? `<p class="th">${letter.body_th[i]}</p>` : ''}
    `).join('')}
  </div>

  <div class="footer">
    <p><strong>Property:</strong> ${caseInfo.property_address}</p>
    ${caseInfo.deposit_amount_thb ? `<p><strong>Deposit:</strong> ฿${caseInfo.deposit_amount_thb.toLocaleString()}</p>` : ''}
    <p style="margin-top: 15px; font-style: italic;">
      This letter is generated by Lease Shield for documentation purposes only. 
      It does not constitute legal advice.
    </p>
    <p style="margin-top: 5px;">© ${year} Lease Shield</p>
  </div>
</body>
</html>`;
};

Deno.serve(async (req) => {
  try {
    const base44 = createClientFromRequest(req);
    
    const user = await base44.auth.me();
    if (!user) {
      return Response.json({ error: 'Unauthorized' }, { status: 401 });
    }

    const payload = await req.json();
    const { 
      caseId,
      tenant_name = "Tenant",
      landlord_name = "Landlord", 
      property_address = "the rented property",
      contract_ref = "Lease Agreement",
      deposit_amount_thb,
      dispute_type = "deposit",
      facts = [],
      request_by_date_iso,
      tone = "standard"
    } = payload;

    if (!caseId) {
      return Response.json({ error: 'caseId is required' }, { status: 400 });
    }

    console.log('Generating letter for case:', caseId);

    // Check if letter already exists
    const existingDocs = await base44.entities.Document.filter({
      type: 'letter',
      created_by: user.email
    });
    
    const existingLetter = existingDocs.find(doc => 
      doc.label && doc.label.includes(caseId.slice(0, 8))
    );
    
    if (existingLetter) {
      console.log('Letter already exists for this case');
      return Response.json({
        success: true,
        caseId,
        message: 'Letter already generated',
        letter_url: existingLetter.file_url
      });
    }

    const isTemporaryCase = caseId.startsWith('temp-');

    // Build simple, clear prompt
    const factsText = facts.length > 0 ? facts.join('. ') : 'Tenant moved out and returned keys as agreed.';
    const deadline = request_by_date_iso || new Date(Date.now() + 14 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];

    const promptText = `Generate a professional bilingual letter for this rental dispute:

CASE DETAILS:
- Tenant Name: ${tenant_name}
- Landlord Name: ${landlord_name}
- Property: ${property_address}
- Dispute: ${dispute_type}
- Deposit Amount: ${deposit_amount_thb ? `฿${deposit_amount_thb}` : 'N/A'}
- Key Facts: ${factsText}
- Response Deadline: ${deadline}
- Tone: ${tone}

Generate ONE letter requesting resolution. Be polite, factual, and professional.`;

    console.log('Calling LLM...');
    
    const result = await base44.integrations.Core.InvokeLLM({
      prompt: `${LETTER_WRITER_PROMPT}\n\n${promptText}`,
      response_json_schema: {
        type: "object",
        properties: {
          subject_en: { type: "string" },
          subject_th: { type: "string" },
          body_en: { type: "array", items: { type: "string" }, minItems: 3 },
          body_th: { type: "array", items: { type: "string" }, minItems: 3 }
        },
        required: ["subject_en", "subject_th", "body_en", "body_th"]
      }
    });

    console.log('LLM response received');

    // Validate response
    if (!result || typeof result !== 'object') {
      throw new Error('Invalid LLM response format');
    }

    if (!result.subject_en || !result.subject_th) {
      throw new Error('Missing subject lines');
    }

    if (!Array.isArray(result.body_en) || result.body_en.length === 0) {
      throw new Error('Invalid body_en: must be non-empty array');
    }

    if (!Array.isArray(result.body_th) || result.body_th.length === 0) {
      throw new Error('Invalid body_th: must be non-empty array');
    }

    console.log('Letter validation passed');

    // Generate HTML
    const caseInfo = {
      caseId,
      property_address,
      deposit_amount_thb
    };

    const htmlContent = getLetterHTML(result, caseInfo);

    // Upload
    const encoder = new TextEncoder();
    const htmlBytes = encoder.encode(htmlContent);
    const blob = new Blob([htmlBytes], { type: 'text/html; charset=utf-8' });
    const file = new File([blob], `letter_${caseId}.html`, { type: 'text/html; charset=utf-8' });

    const { file_url } = await base44.integrations.Core.UploadFile({ file });

    // Save document
    const doc = await base44.entities.Document.create({
      type: 'letter',
      file_url,
      label: `${contract_ref} - Case ${caseId.slice(0, 8)}`
    });

    console.log('Letter saved:', doc.id);

    // Update case if not temporary
    if (!isTemporaryCase) {
      const cases = await base44.entities.Case.list();
      const existingCase = cases.find(c => c.id === caseId);
      
      if (existingCase) {
        const timeline = existingCase.timeline || [];
        timeline.push({
          timestamp: new Date().toISOString(),
          event: 'Letter generated',
          actor: user.email
        });

        await base44.entities.Case.update(caseId, {
          status: 'ready_drafts',
          letters: {
            letter_url: file_url,
            letter_data: result
          },
          timeline
        });

        console.log('Case updated');

        // Send email notification
        const language = user.language || 'en';
        await base44.integrations.Core.SendEmail({
          to: user.email,
          subject: language === 'th' ? 'จดหมายของคุณพร้อมแล้ว' : 'Your Letter is Ready',
          body: language === 'th' ?
            `สวัสดี ${user.full_name},\n\nจดหมายสำหรับคดี #${caseId.slice(0, 8)} พร้อมแล้ว\nคุณสามารถดูและพิมพ์ได้ที่แดชบอร์ด\n\n— ทีม Lease Shield` :
            `Hi ${user.full_name},\n\nYour letter for Case #${caseId.slice(0, 8)} is ready.\nYou can view and print it from your dashboard.\n\n— The Lease Shield Team`
        });
      }
    }

    return Response.json({
      success: true,
      caseId,
      letter_url: file_url,
      letter: result,
      isTemporary: isTemporaryCase
    });

  } catch (error) {
    console.error('Letter generation error:', error);
    return Response.json({ 
      error: error.message || 'Failed to generate letter',
      details: error.stack 
    }, { status: 500 });
  }
});