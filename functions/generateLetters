import { createClientFromRequest } from 'npm:@base44/sdk@0.7.1';

// Decode HTML entities - simple and reliable
function decodeEntities(text) {
  if (!text) return '';
  return text
    .replace(/&#(\d+);/g, (_, num) => String.fromCharCode(parseInt(num, 10)))
    .replace(/&#x([0-9A-Fa-f]+);/g, (_, hex) => String.fromCharCode(parseInt(hex, 16)))
    .replace(/&quot;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&amp;/g, '&');
}

// Simple HTML template
function createLetterHTML(letter, caseInfo) {
  const today = new Date().toISOString().split('T')[0];
  
  const bodyHTML = letter.body_en.map((enPara, i) => `
    <p style="margin-bottom: 8px; font-size: 15px;">${enPara}</p>
    <p style="margin-bottom: 20px; font-size: 15px; color: #666; font-family: 'Noto Sans Thai', 'Sarabun', sans-serif;">${letter.body_th[i] || ''}</p>
  `).join('');
  
  return `<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>${letter.subject_en}</title>
<style>
  body {
    font-family: -apple-system, BlinkMacSystemFont, Arial, sans-serif;
    line-height: 1.6;
    color: #111;
    max-width: 800px;
    margin: 40px auto;
    padding: 20px;
  }
  .header {
    border-bottom: 3px solid #0C3B2E;
    padding-bottom: 15px;
    margin-bottom: 30px;
  }
  .logo {
    font-size: 24px;
    font-weight: 700;
    color: #0C3B2E;
  }
  .date {
    color: #666;
    font-size: 14px;
    margin-top: 5px;
  }
  h1 {
    color: #0C3B2E;
    font-size: 22px;
    margin: 20px 0 10px;
  }
  .thai-title {
    font-family: 'Noto Sans Thai', 'Sarabun', 'Leelawadee UI', sans-serif;
    color: #666;
    font-size: 18px;
    margin-bottom: 30px;
  }
  .footer {
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid #ddd;
    font-size: 12px;
    color: #999;
  }
</style>
</head>
<body>
  <div class="header">
    <div class="logo">LEASE SHIELD</div>
    <div class="date">Date: ${today}</div>
    <div class="date">Case: ${caseInfo.caseId.slice(0, 8)}</div>
  </div>

  <h1>${letter.subject_en}</h1>
  <p class="thai-title">${letter.subject_th}</p>

  <div>${bodyHTML}</div>

  <div class="footer">
    <p><strong>Property:</strong> ${caseInfo.property_address}</p>
    ${caseInfo.deposit_amount_thb ? `<p><strong>Deposit:</strong> ฿${caseInfo.deposit_amount_thb.toLocaleString()}</p>` : ''}
    <p style="margin-top: 15px; font-style: italic;">
      This letter is for documentation purposes only.
    </p>
    <p>© ${new Date().getFullYear()} Lease Shield</p>
  </div>
</body>
</html>`;
}

Deno.serve(async (req) => {
  try {
    const base44 = createClientFromRequest(req);
    const user = await base44.auth.me();
    
    if (!user) {
      return Response.json({ error: 'Unauthorized' }, { status: 401 });
    }

    const { 
      caseId,
      tenant_name = "Tenant",
      landlord_name = "Landlord", 
      property_address = "the property",
      deposit_amount_thb,
      dispute_type = "deposit",
      facts = []
    } = await req.json();

    if (!caseId) {
      return Response.json({ error: 'caseId required' }, { status: 400 });
    }

    console.log('Generating letter for case:', caseId);

    // Check existing
    const existingDocs = await base44.entities.Document.filter({
      type: 'letter',
      created_by: user.email
    });
    
    const existing = existingDocs.find(doc => 
      doc.label && doc.label.includes(caseId.slice(0, 8))
    );
    
    if (existing) {
      console.log('Letter already exists');
      return Response.json({
        success: true,
        letter_url: existing.file_url,
        message: 'Already generated'
      });
    }

    // Build prompt
    const factsText = facts.length > 0 ? facts.join('. ') : 'Tenant moved out and returned keys as agreed.';
    
    const prompt = `Write a professional bilingual letter (English + Thai) for this rental dispute:

DETAILS:
- Tenant: ${tenant_name}
- Landlord: ${landlord_name}
- Property: ${property_address}
- Issue: ${dispute_type}
${deposit_amount_thb ? `- Deposit: ฿${deposit_amount_thb}` : ''}
- Facts: ${factsText}

REQUIREMENTS:
- Professional and polite tone
- Each English paragraph needs matching Thai paragraph
- Keep it concise (150-200 words)

CRITICAL: Output Thai as ACTUAL Unicode characters (สวัสดี), NOT HTML codes.

Return JSON:
{
  "subject_en": "English subject",
  "subject_th": "หัวข้อภาษาไทย",
  "body_en": ["Para 1", "Para 2", "Para 3"],
  "body_th": ["ย่อหน้า 1", "ย่อหน้า 2", "ย่อหน้า 3"]
}`;

    console.log('Calling LLM...');
    
    const llmResult = await base44.integrations.Core.InvokeLLM({
      prompt,
      response_json_schema: {
        type: "object",
        properties: {
          subject_en: { type: "string" },
          subject_th: { type: "string" },
          body_en: { type: "array", items: { type: "string" } },
          body_th: { type: "array", items: { type: "string" } }
        },
        required: ["subject_en", "subject_th", "body_en", "body_th"]
      }
    });

    console.log('LLM responded');

    if (!llmResult?.subject_en || !llmResult?.body_en) {
      throw new Error('Invalid LLM response');
    }

    // DECODE IMMEDIATELY after receiving from LLM
    const cleanLetter = {
      subject_en: decodeEntities(llmResult.subject_en),
      subject_th: decodeEntities(llmResult.subject_th),
      body_en: llmResult.body_en.map(p => decodeEntities(p)),
      body_th: llmResult.body_th.map(p => decodeEntities(p))
    };

    console.log('Letter decoded and validated');

    // Generate HTML with clean data
    const htmlContent = createLetterHTML(cleanLetter, {
      caseId,
      property_address,
      deposit_amount_thb
    });

    // Upload
    const htmlBlob = new Blob([htmlContent], { type: 'text/html; charset=utf-8' });
    const file = new File([htmlBlob], `letter_${caseId}.html`, { type: 'text/html' });
    const { file_url } = await base44.integrations.Core.UploadFile({ file });

    // Save document
    await base44.entities.Document.create({
      type: 'letter',
      file_url,
      label: `Letter - Case ${caseId.slice(0, 8)}`
    });

    console.log('Letter saved successfully');

    // Update case if not temporary
    if (!caseId.startsWith('temp-')) {
      const cases = await base44.entities.Case.list();
      const caseData = cases.find(c => c.id === caseId);
      
      if (caseData) {
        await base44.entities.Case.update(caseId, {
          status: 'ready_drafts',
          letters: { letter_url: file_url, letter_data: cleanLetter }
        });

        // Email notification
        await base44.integrations.Core.SendEmail({
          to: user.email,
          subject: user.language === 'th' ? 'จดหมายพร้อมแล้ว' : 'Your Letter is Ready',
          body: `Hi ${user.full_name},\n\nYour letter for case ${caseId.slice(0, 8)} is ready.\n\n— Lease Shield`
        });
      }
    }

    return Response.json({
      success: true,
      caseId,
      letter_url: file_url,
      letter: cleanLetter
    });

  } catch (error) {
    console.error('Error:', error);
    return Response.json({ 
      error: error.message,
      stack: error.stack 
    }, { status: 500 });
  }
});