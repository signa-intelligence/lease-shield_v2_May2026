///////////////////////////////
// Main entry point //
///////////////////////////////
Deno.serve(async (req) => {
  try {
    const base44 = createClientFromRequest(req);
    const user = await base44.auth.me();
    if (!user) return Response.json({ error: 'Unauthorized' }, { status: 401 });

    const payload = await req.json();
    
    // Extract data from payload - support both direct values and from case lookup
    const caseId = payload.caseId;
    const subject = payload.subject || payload.dispute_type || 'deposit';
    
    if (!caseId) return Response.json({ error: 'caseId required' }, { status: 400 });

    console.log('Generating letter for case:', caseId, 'subject:', subject);

    // Prepare variables - use payload data directly if provided, otherwise try to load from case
    let vars = {
      caseId: safe(caseId).slice(0, 12),
      tenant_name: safe(payload.tenant_name, "Tenant"),
      landlord_name: safe(payload.landlord_name, "Landlord"),
      property_address: safe(payload.property_address, ""),
      contract_ref: safe(payload.contract_ref, "Lease Agreement"),
      deposit_amount_thb: payload.deposit_amount_thb ? safeNum(payload.deposit_amount_thb) : "—",
      request_by_date_iso: safe(payload.request_by_date_iso, safeISO(null, 14)),
      attachments_list: Array.isArray(payload.attachments) ? payload.attachments.join("; ") : safe(payload.attachments, "Lease.pdf")
    };

    // If case ID is not temporary, try to load and merge case data
    if (!caseId.startsWith('temp-')) {
      try {
        const cases = await base44.entities.Case.list();
        const c = cases.find(cs => cs.id === caseId);
        
        if (c) {
          // Merge case data with payload data (payload takes priority)
          vars = {
            caseId: safe(c.id).slice(0, 12),
            tenant_name: payload.tenant_name || safe(c.tenant_name, "Tenant"),
            landlord_name: payload.landlord_name || safe(c.landlord_name, "Landlord"),
            property_address: payload.property_address || safe(c.property_address, ""),
            contract_ref: payload.contract_ref || safe(c.contract_ref, "Lease Agreement"),
            deposit_amount_thb: payload.deposit_amount_thb ? safeNum(payload.deposit_amount_thb) : safeNum(c?.dispute_amount),
            request_by_date_iso: payload.request_by_date_iso || safeISO(c?.sla?.followup_due, 14),
            attachments_list: payload.attachments ? (Array.isArray(payload.attachments) ? payload.attachments.join("; ") : payload.attachments) : joinList(c?.evidence || [])
          };
        }
      } catch (err) {
        console.log('Could not load case, using payload data only:', err.message);
      }
    }

    // Generate letter content
    const copy = buildCopy(subject, vars);
    const html = fill(TEMPLATE_HTML, { ...vars, ...copy });

    // FIX: Let Blob handle UTF-8 encoding naturally
    const blob = new Blob([html], { type: 'text/html; charset=utf-8' });
    const filename = `${vars.caseId}_${subject}.html`;
    const file = new File([blob], filename, { type: 'text/html; charset=utf-8' });
    
    const { file_url } = await base44.integrations.Core.UploadFile({ file });

    // Save to document vault
    await base44.entities.Document.create({
      type: 'letter',
      file_url,
      label: `Letter ${subject} - Case ${caseId.slice(0, 8)}`
    });

    // Update case if it exists and is not temporary
    if (!caseId.startsWith('temp-')) {
      try {
        const cases = await base44.entities.Case.list();
        const c = cases.find(cs => cs.id === caseId);
        
        if (c) {
          await base44.entities.Case.update(caseId, {
            letters: {
              ...(c.letters || {}),
              [`${subject}_url`]: file_url
            }
          });
        }
      } catch (err) {
        console.log('Could not update case:', err.message);
      }
    }

    console.log('Letter generated:', file_url);

    return Response.json({ 
      success: true,
      ok: true, 
      url: file_url, 
      subject: subject,
      isTemporary: caseId.startsWith('temp-')
    });

  } catch (error) {
    console.error('Error:', error);
    return Response.json({ error: error.message }, { status: 500 });
  }
});
