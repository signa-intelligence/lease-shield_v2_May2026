import { createClientFromRequest } from 'npm:@base44/sdk@0.7.1';

// Simple letter templates - one per subject
const LETTER_TEMPLATES = {
  deposit: {
    subject_en: "Request for Return of Security Deposit",
    subject_th: "ขอคืนเงินประกันการเช่า",
    body_en: (data) => `Dear ${data.landlord_name},

I am writing to request the return of my security deposit for the property at ${data.property_address}.

As per our lease agreement dated ${data.contract_ref}, I paid a security deposit of ${data.deposit_amount_thb} THB.

I vacated the property on the agreed date and returned all keys. The property was left in good condition.

Please arrange to return the deposit within 14 days. If there are any deductions, please provide an itemized list with supporting documentation.

You can reach me at this email address for any questions.

Sincerely,
${data.tenant_name}`,
    body_th: (data) => `เรียน ${data.landlord_name}

ข้าพเจ้าเขียนจดหมายฉบับนี้เพื่อขอคืนเงินประกันการเช่าสำหรับทรัพย์สินที่ ${data.property_address}

ตามสัญญาเช่าลงวันที่ ${data.contract_ref} ข้าพเจ้าได้ชำระเงินประกัน ${data.deposit_amount_thb} บาท

ข้าพเจ้าได้ย้ายออกตามกำหนดและคืนกุญแจทั้งหมดแล้ว ทรัพย์สินอยู่ในสภาพดี

กรุณาจัดการคืนเงินประกันภายใน 14 วัน หากมีการหักเงิน กรุณาแจ้งรายละเอียดพร้อมเอกสารประกอบ

ติดต่อข้าพเจ้าได้ที่อีเมลนี้หากมีข้อสงสัย

ขอแสดงความนับถือ
${data.tenant_name}`
  },
  
  damages: {
    subject_en: "Response to Damage Claims",
    subject_th: "ตอบกลับเรื่องการเรียกค่าเสียหาย",
    body_en: (data) => `Dear ${data.landlord_name},

I received your notice regarding damage claims for ${data.property_address}.

I would like to respectfully dispute these claims for the following reasons:

1. The property was in good condition when I moved out
2. Normal wear and tear should not be charged to the tenant
3. Some issues existed before I moved in

I request an itemized breakdown of claimed damages with supporting evidence (photos, receipts, estimates).

Please provide this information within 7 days so we can resolve this matter fairly.

Sincerely,
${data.tenant_name}`,
    body_th: (data) => `เรียน ${data.landlord_name}

ข้าพเจ้าได้รับแจ้งเรื่องการเรียกค่าเสียหายสำหรับ ${data.property_address}

ข้าพเจ้าขอโต้แย้งการเรียกร้องนี้ด้วยเหตุผลดังนี้:

1. ทรัพย์สินอยู่ในสภาพดีเมื่อข้าพเจ้าย้ายออก
2. การสึกหรอตามปกติไม่ควรเรียกเก็บจากผู้เช่า
3. บางปัญหามีอยู่แล้วก่อนที่ข้าพเจ้าเข้าอยู่

ข้าพเจ้าขอรายละเอียดความเสียหายแบบแยกรายการพร้อมหลักฐาน (รูปถ่าย ใบเสร็จ ใบเสนอราคา)

กรุณาให้ข้อมูลภายใน 7 วัน เพื่อเราจะได้แก้ไขปัญหานี้อย่างยุติธรรม

ขอแสดงความนับถือ
${data.tenant_name}`
  },
  
  early_termination: {
    subject_en: "Notice of Early Lease Termination",
    subject_th: "แจ้งยกเลิกสัญญาเช่าก่อนกำหนด",
    body_en: (data) => `Dear ${data.landlord_name},

I am writing to formally notify you of my intention to terminate the lease for ${data.property_address} early.

According to our agreement dated ${data.contract_ref}, I understand there may be penalties for early termination. I would like to discuss the following:

1. The exact termination fees as per the contract
2. The final move-out date
3. The deposit return process
4. Final utility readings and settlements

Please let me know your availability to discuss these matters and finalize the termination terms.

Sincerely,
${data.tenant_name}`,
    body_th: (data) => `เรียน ${data.landlord_name}

ข้าพเจ้าเขียนจดหมายฉบับนี้เพื่อแจ้งความประสงค์ยกเลิกสัญญาเช่าสำหรับ ${data.property_address} ก่อนกำหนด

ตามสัญญาลงวันที่ ${data.contract_ref} ข้าพเจ้าเข้าใจว่าอาจมีค่าปรับสำหรับการยกเลิกก่อนกำหนด ข้าพเจ้าต้องการหารือเรื่อง:

1. ค่าธรรมเนียมการยกเลิกตามสัญญา
2. วันที่ย้ายออกครั้งสุดท้าย
3. กระบวนการคืนเงินประกัน
4. การอ่านมิเตอร์และการชำระค่าสาธารณูปโภคครั้งสุดท้าย

กรุณาแจ้งความพร้อมของท่านเพื่อหารือและสรุปเงื่อนไขการยกเลิก

ขอแสดงความนับถือ
${data.tenant_name}`
  }
};

Deno.serve(async (req) => {
  try {
    const base44 = createClientFromRequest(req);
    const user = await base44.auth.me();
    if (!user) return Response.json({ error: 'Unauthorized' }, { status: 401 });

    const { subject, tenant_name, landlord_name, property_address, contract_ref, deposit_amount_thb } = await req.json();
    
    if (!subject || !tenant_name || !landlord_name) {
      return Response.json({ error: 'Missing required fields' }, { status: 400 });
    }

    const template = LETTER_TEMPLATES[subject];
    if (!template) {
      return Response.json({ error: 'Invalid subject' }, { status: 400 });
    }

    const data = {
      tenant_name,
      landlord_name,
      property_address: property_address || '[Property Address]',
      contract_ref: contract_ref || '[Contract Reference]',
      deposit_amount_thb: deposit_amount_thb || '[Amount]'
    };

    // Generate simple HTML
    const html = `<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>${template.subject_en}</title>
<style>
body { font-family: Arial, sans-serif; line-height: 1.6; max-width: 800px; margin: 40px auto; padding: 20px; }
.letter { margin-bottom: 40px; }
.subject { font-weight: bold; margin-bottom: 20px; font-size: 16px; }
.body { white-space: pre-wrap; margin-bottom: 20px; }
.divider { border-top: 1px solid #ccc; margin: 40px 0; }
</style>
</head>
<body>
<div class="letter">
<div class="subject">${template.subject_en}</div>
<div class="body">${template.body_en(data)}</div>
</div>

<div class="divider"></div>

<div class="letter">
<div class="subject">${template.subject_th}</div>
<div class="body">${template.body_th(data)}</div>
</div>
</body>
</html>`;

    // Upload the letter
    const blob = new Blob([html], { type: 'text/html; charset=utf-8' });
    const filename = `letter_${subject}_${Date.now()}.html`;
    const file = new File([blob], filename);
    
    const { file_url } = await base44.integrations.Core.UploadFile({ file });

    // Save to documents
    await base44.entities.Document.create({
      type: 'letter',
      file_url,
      label: `${template.subject_en}`
    });

    return Response.json({ 
      success: true,
      url: file_url
    });

  } catch (error) {
    console.error('Error:', error);
    return Response.json({ error: error.message }, { status: 500 });
  }
});