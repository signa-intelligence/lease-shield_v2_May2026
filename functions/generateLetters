Deno.serve(async (req) => {
  try {
    const base44 = createClientFromRequest(req);
    const user = await base44.auth.me();
    if (!user) return Response.json({ error: 'Unauthorized' }, { status: 401 });

    const {
      caseId,
      tenant_name = "Tenant",
      landlord_name = "Landlord",
      property_address = "the property",
      contract_ref = "Lease Agreement",
      deposit_amount_thb = 0,
      request_by_date_iso = new Date(Date.now() + 14 * 86400000).toISOString().split('T')[0],
      attachments_list = "Lease.pdf; Photos.zip"
    } = await req.json();

    if (!caseId) return Response.json({ error: 'caseId required' }, { status: 400 });

    console.log('Generating letters for:', caseId);

    // Check if already generated
    const existing = await base44.entities.Document.filter({
      type: 'letter',
      created_by: user.email
    });
    if (existing.find(d => d.label?.includes(caseId.slice(0, 8)))) {
      console.log('Already exists');
      return Response.json({ success: true, message: 'Already generated' });
    }

    // Prepare data for templates
    const data = {
      caseId: caseId.slice(0, 12),
      tenant_name,
      landlord_name,
      property_address,
      contract_ref,
      deposit_amount_thb: deposit_amount_thb.toLocaleString(),
      request_by_date_iso,
      attachments_list
    };

    const encoder = new TextEncoder();
    const urls = {};

    // Generate all 3 letters
    for (const variant of ['v1', 'v2', 'v3']) {
      const html = fill(TEMPLATES[variant], data);
      const blob = new Blob([encoder.encode(html)], { type: 'text/html; charset=utf-8' });
      const file = new File([blob], `${caseId}_${variant}.html`, { type: 'text/html' });
      
      const { file_url } = await base44.integrations.Core.UploadFile({ file });
      urls[`${variant}_url`] = file_url;

      await base44.entities.Document.create({
        type: 'letter',
        file_url,
        label: `Letter ${variant.toUpperCase()} - Case ${caseId.slice(0, 8)}`
      });
    }

    console.log('All letters uploaded:', urls);

    // Update case
    if (!caseId.startsWith('temp-')) {
      const cases = await base44.entities.Case.list();
      const caseData = cases.find(c => c.id === caseId);
      
      if (caseData) {
        await base44.entities.Case.update(caseId, {
          status: 'ready_drafts',
          letters: urls
        });

        await base44.integrations.Core.SendEmail({
          to: user.email,
          subject: user.language === 'th' ? 'จดหมายพร้อมแล้ว' : 'Your Letters are Ready',
          body: `Hi ${user.full_name},\n\nYour 3-letter pack for case ${caseId.slice(0, 8)} is ready.\n\n— Lease Shield`
        });
      }
    }

    return Response.json({ success: true, caseId, letters: urls });
  } catch (error) {
    console.error('Error:', error);
    return Response.json({ error: error.message }, { status: 500 });
  }
});