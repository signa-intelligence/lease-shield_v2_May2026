import { createClientFromRequest } from 'npm:@base44/sdk@0.7.1';

// Clean HTML template - no LLM, just fill placeholders
const LETTER_TEMPLATE = `<!doctype html><html lang="en"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Deposit clarification – {{caseId}}</title>
<style>
  @page{size:A4;margin:20mm 18mm}
  body{font-family:Inter,Arial,"Noto Sans Thai","TH Sarabun New",sans-serif;line-height:1.5;color:#111;font-size:12.2pt}
  h1{color:#0C3B2E;margin:0 0 6mm}
  .muted{color:#667085}
  .pair{margin:0 0 5mm}
  .th{font-family:"Noto Sans Thai","TH Sarabun New",sans-serif}
</style></head><body>
<h1>Request for clarification on refundable deposit</h1>
<p class="muted th">ขอความชัดเจนเกี่ยวกับเงินประกันการเช่า</p>

<div class="pair">
  <p>Dear {{landlord_name}}, this note summarises the completion of the tenancy for {{property_address}} and requests an update about the refundable deposit.</p>
  <p class="th">เรียน {{landlord_name}} หนังสือฉบับนี้สรุปการสิ้นสุดการเช่าสำหรับ {{property_address}} และขอความคืบหน้าเกี่ยวกับการคืนเงินประกัน</p>
</div>

<div class="pair">
  <p>{{contract_ref}}. Supporting evidence is attached for easy reference.</p>
  <p class="th">{{contract_ref}} และได้แนบหลักฐานประกอบเพื่อความสะดวก</p>
</div>

<div class="pair">
  <p>To reconcile promptly, please provide: (1) any proposed deductions with itemised reasons and documents, or (2) confirmation of refund transfer details.</p>
  <p class="th">เพื่อให้ปิดบัญชีได้รวดเร็ว กรุณาแจ้ง (1) รายการหักพร้อมเหตุผลและเอกสาร หรือ (2) การยืนยันรายละเอียดการโอนเงินคืน</p>
</div>

<div class="pair">
  <p>Kindly reply by {{request_by_date_iso}} so both sides can close this matter smoothly.</p>
  <p class="th">กรุณาตอบกลับภายในวันที่ {{request_by_date_iso}} เพื่อให้ทั้งสองฝ่ายสามารถปิดเรื่องนี้ได้อย่างราบรื่น</p>
</div>

<hr>
<p><strong>Context / ข้อมูลอ้างอิง</strong></p>
<p>Tenant / ผู้เช่า: {{tenant_name}}</p>
<p>Landlord / เจ้าของ: {{landlord_name}}</p>
<p>Deposit (THB) / เงินประกัน: {{deposit_amount_thb}}</p>
<p>Attachments / ไฟล์แนบ: {{attachments_list}}</p>

<p style="margin-top:10mm">Kind regards,<br>Lease Shield</p>
<p class="th">ขอแสดงความนับถือ<br>Lease Shield</p>
<p class="muted" style="margin-top:6mm">This is documentation & communication support, not legal advice.</p>
</body></html>`;

function fillTemplate(template, data) {
  let html = template;
  for (const [key, value] of Object.entries(data)) {
    const placeholder = `{{${key}}}`;
    html = html.replaceAll(placeholder, String(value || '—'));
  }
  return html;
}

Deno.serve(async (req) => {
  try {
    const base44 = createClientFromRequest(req);
    const user = await base44.auth.me();
    
    if (!user) {
      return Response.json({ error: 'Unauthorized' }, { status: 401 });
    }

    const payload = await req.json();
    const { 
      caseId,
      tenant_name = "Tenant",
      landlord_name = "Landlord", 
      property_address = "the property",
      contract_ref = "Lease dated YYYY-MM-DD (optional)",
      deposit_amount_thb = 0,
      request_by_date_iso = "YYYY-MM-DD",
      attachments_list = "Lease.pdf; Photos.zip; Receipts.pdf"
    } = payload;

    if (!caseId) {
      return Response.json({ error: 'caseId required' }, { status: 400 });
    }

    console.log('Generating letter for case:', caseId);

    // Check existing letter
    const existingDocs = await base44.entities.Document.filter({
      type: 'letter',
      created_by: user.email
    });
    
    const existing = existingDocs.find(doc => 
      doc.label && doc.label.includes(caseId.slice(0, 8))
    );
    
    if (existing) {
      console.log('Letter already exists');
      return Response.json({
        success: true,
        letter_url: existing.file_url,
        message: 'Already generated'
      });
    }

    // Fill template with actual data
    const filledHTML = fillTemplate(LETTER_TEMPLATE, {
      caseId: caseId.slice(0, 12),
      tenant_name,
      landlord_name,
      property_address,
      contract_ref,
      deposit_amount_thb: deposit_amount_thb.toLocaleString(),
      request_by_date_iso,
      attachments_list
    });

    console.log('Template filled successfully');

    // Upload HTML file with proper UTF-8 encoding
    const encoder = new TextEncoder();
    const utf8Bytes = encoder.encode(filledHTML);
    const blob = new Blob([utf8Bytes], { type: 'text/html; charset=utf-8' });
    const file = new File([blob], `letter_${caseId}.html`, { type: 'text/html' });
    
    const { file_url } = await base44.integrations.Core.UploadFile({ file });

    // Save document
    await base44.entities.Document.create({
      type: 'letter',
      file_url,
      label: `Letter - Case ${caseId.slice(0, 8)}`
    });

    console.log('Letter saved:', file_url);

    // Update case if not temporary
    if (!caseId.startsWith('temp-')) {
      const cases = await base44.entities.Case.list();
      const caseData = cases.find(c => c.id === caseId);
      
      if (caseData) {
        await base44.entities.Case.update(caseId, {
          status: 'ready_drafts',
          letters: { 
            letter_url: file_url,
            v1_url: file_url
          }
        });

        // Send email notification
        await base44.integrations.Core.SendEmail({
          to: user.email,
          subject: user.language === 'th' ? 'จดหมายพร้อมแล้ว' : 'Your Letter is Ready',
          body: `Hi ${user.full_name},\n\nYour letter for case ${caseId.slice(0, 8)} is ready to view and download.\n\n— Lease Shield`
        });
      }
    }

    return Response.json({
      success: true,
      caseId,
      letter_url: file_url
    });

  } catch (error) {
    console.error('Error:', error);
    return Response.json({ 
      error: error.message,
      stack: error.stack 
    }, { status: 500 });
  }
});