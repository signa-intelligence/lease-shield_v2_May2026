
import { createClientFromRequest } from 'npm:@base44/sdk@0.7.1';

///////////////////////
// Safe util helpers //
///////////////////////
const safe = (v, d = "") => (v === null || v === undefined ? d : v);
const safeNum = (v) => {
  const n = Number(v);
  return Number.isFinite(n) ? n.toLocaleString("en-US", { maximumFractionDigits: 0 }) : "";
};
const safeISO = (v, plusDays = 7) => {
  if (v) {
    try { return new Date(v).toISOString().slice(0, 10); } catch {}
  }
  return new Date(Date.now() + plusDays * 864e5).toISOString().slice(0, 10);
};
const joinList = (arr) => Array.isArray(arr) && arr.length ? arr.map(x => x?.filename || x).join("; ") : "";

const fill = (tpl, vars) =>
  tpl.replace(/\{\{\s*([\w.]+)\s*\}\}/g, (_, k) => (k in vars && vars[k] !== null && vars[k] !== undefined ? String(vars[k]) : ""));

