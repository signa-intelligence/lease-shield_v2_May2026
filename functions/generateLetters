import { createClientFromRequest } from 'npm:@base44/sdk@0.7.1';

// Pre-written bilingual letter templates - NO ENCODING ISSUES
const LETTER_TEMPLATES = {
  deposit_return: {
    subject_en: "Request for Return of Security Deposit",
    subject_th: "ขอคืนเงินประกันการเช่า",
    body_en: [
      "Dear {{landlord_name}},",
      "I am writing to formally request the return of my security deposit of ฿{{deposit_amount}} for the property located at {{property_address}}.",
      "I vacated the property on the agreed date and returned all keys. The property was left in good condition with no damages beyond normal wear and tear.",
      "According to our lease agreement ({{contract_ref}}), I expect the deposit to be returned by {{return_date}}.",
      "Please arrange for the refund at your earliest convenience. I can be reached at this email address for any questions.",
      "Thank you for your attention to this matter.",
      "Sincerely,",
      "{{tenant_name}}"
    ],
    body_th: [
      "เรียน คุณ{{landlord_name}}",
      "ข้าพเจ้าเขียนจดหมายฉบับนี้เพื่อขอคืนเงินประกันการเช่าจำนวน ฿{{deposit_amount}} สำหรับทรัพย์สินที่ตั้งอยู่ที่ {{property_address}}",
      "ข้าพเจ้าได้ย้ายออกจากทรัพย์สินตามกำหนดและคืนกุญแจทั้งหมดแล้ว ทรัพย์สินอยู่ในสภาพดีโดยไม่มีความเสียหายนอกเหนือจากการสึกหรอตามปกติ",
      "ตามสัญญาเช่า ({{contract_ref}}) ข้าพเจ้าคาดว่าจะได้รับเงินประกันคืนภายในวันที่ {{return_date}}",
      "กรุณาจัดการคืนเงินโดยเร็วที่สุด ท่านสามารถติดต่อข้าพเจ้าได้ทางอีเมลนี้หากมีข้อสงสัย",
      "ขอบคุณสำหรับความร่วมมือ",
      "ขอแสดงความนับถือ",
      "{{tenant_name}}"
    ]
  }
};

function fillTemplate(template, data) {
  let text = template;
  for (const [key, value] of Object.entries(data)) {
    const placeholder = `{{${key}}}`;
    text = text.replaceAll(placeholder, value || '—');
  }
  return text;
}

function createLetterHTML(letterData, caseInfo) {
  const today = new Date().toISOString().split('T')[0];
  
  const paragraphs = letterData.body_en.map((enPara, i) => {
    const thPara = letterData.body_th[i] || '';
    return `    <p class="en">${enPara}</p>
    <p class="th">${thPara}</p>`;
  }).join('\n');
  
  return `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${letterData.subject_en}</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
      line-height: 1.6;
      color: #111;
      max-width: 800px;
      margin: 40px auto;
      padding: 20px;
    }
    .header {
      border-bottom: 3px solid #0C3B2E;
      padding-bottom: 15px;
      margin-bottom: 30px;
    }
    .logo { font-size: 24px; font-weight: 700; color: #0C3B2E; }
    .date { color: #666; font-size: 14px; margin-top: 5px; }
    h1 { color: #0C3B2E; font-size: 22px; margin: 20px 0 10px; }
    .thai-title {
      font-family: 'Sarabun', 'Leelawadee UI', sans-serif;
      color: #666;
      font-size: 18px;
      margin-bottom: 30px;
    }
    .en { margin-bottom: 8px; font-size: 15px; }
    .th {
      font-family: 'Sarabun', 'Leelawadee UI', sans-serif;
      color: #555;
      font-size: 15px;
      margin-bottom: 20px;
    }
    .footer {
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid #ddd;
      font-size: 12px;
      color: #999;
    }
  </style>
</head>
<body>
  <div class="header">
    <div class="logo">LEASE SHIELD</div>
    <div class="date">Date: ${today}</div>
    <div class="date">Case: ${caseInfo.caseId.slice(0, 12)}</div>
  </div>

  <h1>${letterData.subject_en}</h1>
  <p class="thai-title">${letterData.subject_th}</p>

  <div class="content">
${paragraphs}
  </div>

  <div class="footer">
    <p><strong>Property:</strong> ${caseInfo.property_address}</p>
    ${caseInfo.deposit_amount_thb ? `<p><strong>Deposit:</strong> ฿${caseInfo.deposit_amount_thb.toLocaleString()}</p>` : ''}
    <p style="margin-top: 15px; font-style: italic;">
      This letter is for documentation purposes only.
    </p>
    <p>© ${new Date().getFullYear()} Lease Shield</p>
  </div>
</body>
</html>`;
}

Deno.serve(async (req) => {
  try {
    const base44 = createClientFromRequest(req);
    const user = await base44.auth.me();
    
    if (!user) {
      return Response.json({ error: 'Unauthorized' }, { status: 401 });
    }

    const payload = await req.json();
    const { 
      caseId,
      tenant_name = "Tenant",
      landlord_name = "Landlord", 
      property_address = "the property",
      contract_ref = "Lease Agreement",
      deposit_amount_thb = 0,
      request_by_date_iso,
      dispute_type = "deposit"
    } = payload;

    if (!caseId) {
      return Response.json({ error: 'caseId required' }, { status: 400 });
    }

    console.log('Generating letter for case:', caseId);

    // Check existing
    const existingDocs = await base44.entities.Document.filter({
      type: 'letter',
      created_by: user.email
    });
    
    const existing = existingDocs.find(doc => 
      doc.label && doc.label.includes(caseId.slice(0, 8))
    );
    
    if (existing) {
      console.log('Letter already exists');
      return Response.json({
        success: true,
        letter_url: existing.file_url,
        message: 'Already generated'
      });
    }

    // Get template
    const template = LETTER_TEMPLATES.deposit_return;
    
    // Calculate return date
    const returnDate = request_by_date_iso || 
      new Date(Date.now() + 14 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];
    
    // Template data
    const templateData = {
      landlord_name,
      deposit_amount: deposit_amount_thb.toLocaleString(),
      property_address,
      contract_ref,
      return_date: returnDate,
      tenant_name
    };

    // Fill templates
    const letter = {
      subject_en: fillTemplate(template.subject_en, templateData),
      subject_th: fillTemplate(template.subject_th, templateData),
      body_en: template.body_en.map(para => fillTemplate(para, templateData)),
      body_th: template.body_th.map(para => fillTemplate(para, templateData))
    };

    console.log('✅ Thai text sample:', letter.subject_th);

    // Generate HTML
    const htmlContent = createLetterHTML(letter, {
      caseId,
      property_address,
      deposit_amount_thb
    });

    // Upload as UTF-8
    const encoder = new TextEncoder();
    const utf8Bytes = encoder.encode(htmlContent);
    const blob = new Blob([utf8Bytes], { type: 'text/html; charset=utf-8' });
    const file = new File([blob], `letter_${caseId}.html`, { type: 'text/html' });
    
    const { file_url } = await base44.integrations.Core.UploadFile({ file });

    // Save
    await base44.entities.Document.create({
      type: 'letter',
      file_url,
      label: `${contract_ref} - Case ${caseId.slice(0, 8)}`
    });

    console.log('Letter saved:', file_url);

    // Update case
    if (!caseId.startsWith('temp-')) {
      const cases = await base44.entities.Case.list();
      const caseData = cases.find(c => c.id === caseId);
      
      if (caseData) {
        await base44.entities.Case.update(caseId, {
          status: 'ready_drafts',
          letters: { letter_url: file_url, letter_data: letter }
        });

        await base44.integrations.Core.SendEmail({
          to: user.email,
          subject: user.language === 'th' ? 'จดหมายพร้อมแล้ว' : 'Your Letter is Ready',
          body: `Hi ${user.full_name},\n\nYour letter for case ${caseId.slice(0, 8)} is ready.\n\n— Lease Shield`
        });
      }
    }

    return Response.json({
      success: true,
      caseId,
      letter_url: file_url,
      letter
    });

  } catch (error) {
    console.error('Error:', error);
    return Response.json({ 
      error: error.message,
      stack: error.stack 
    }, { status: 500 });
  }
});