import { createClientFromRequest } from 'npm:@base44/sdk@0.7.1';

const LETTER_PROMPT = `You are a professional letter writer for Thai rental disputes.

Generate ONE bilingual letter (English + Thai).

CRITICAL ENCODING RULES:
- Output ONLY valid JSON
- Use actual Unicode Thai characters: สวัสดี ขอบคุณ เช่า
- DO NOT use HTML entities like &#xxxx;
- DO NOT use escaped characters like \\u0E2A
- Each English paragraph must have matching Thai paragraph

Example of CORRECT output:
{
  "subject_en": "Request for Deposit Return",
  "subject_th": "ขอคืนเงินประกันการเช่า",
  "body_en": ["Dear Landlord", "I am writing to request..."],
  "body_th": ["เรียนเจ้าของบ้าน", "ข้าพเจ้าเขียนจดหมายเพื่อขอ..."]
}`;

function createHTML(letter, caseInfo) {
  const date = new Date().toISOString().split('T')[0];
  
  const paragraphs = letter.body_en.map((en, i) => {
    const th = letter.body_th[i] || '';
    return `    <p class="en">${en}</p>
    <p class="th">${th}</p>`;
  }).join('\n');
  
  // Use template literals - no encoding functions, just plain text
  return `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${letter.subject_en}</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
      line-height: 1.6;
      color: #111;
      max-width: 800px;
      margin: 40px auto;
      padding: 20px;
    }
    .header {
      border-bottom: 3px solid #0C3B2E;
      padding-bottom: 15px;
      margin-bottom: 30px;
    }
    .logo {
      font-size: 24px;
      font-weight: 700;
      color: #0C3B2E;
    }
    .date { color: #666; font-size: 14px; margin-top: 5px; }
    h1 { color: #0C3B2E; font-size: 22px; margin: 20px 0 10px; }
    .thai-title {
      font-family: 'Noto Sans Thai', 'Sarabun', 'Leelawadee UI', sans-serif;
      color: #666;
      font-size: 18px;
      margin-bottom: 30px;
    }
    .en { margin-bottom: 8px; font-size: 15px; }
    .th {
      font-family: 'Noto Sans Thai', 'Sarabun', 'Leelawadee UI', sans-serif;
      color: #555;
      font-size: 15px;
      margin-bottom: 20px;
    }
    .footer {
      margin-top: 40px;
      padding-top: 20px;
      border-top: 1px solid #ddd;
      font-size: 12px;
      color: #999;
    }
  </style>
</head>
<body>
  <div class="header">
    <div class="logo">LEASE SHIELD</div>
    <div class="date">Date: ${date}</div>
    <div class="date">Case: ${caseInfo.caseId.slice(0, 8)}</div>
  </div>

  <h1>${letter.subject_en}</h1>
  <p class="thai-title">${letter.subject_th}</p>

  <div class="content">
${paragraphs}
  </div>

  <div class="footer">
    <p><strong>Property:</strong> ${caseInfo.property_address}</p>
    ${caseInfo.deposit_amount_thb ? `<p><strong>Deposit:</strong> ฿${caseInfo.deposit_amount_thb.toLocaleString()}</p>` : ''}
    <p style="margin-top: 15px; font-style: italic;">
      This letter is for documentation purposes only.
    </p>
    <p>© ${new Date().getFullYear()} Lease Shield</p>
  </div>
</body>
</html>`;
}

Deno.serve(async (req) => {
  try {
    const base44 = createClientFromRequest(req);
    const user = await base44.auth.me();
    
    if (!user) {
      return Response.json({ error: 'Unauthorized' }, { status: 401 });
    }

    const payload = await req.json();
    const { 
      caseId,
      tenant_name = "Tenant",
      landlord_name = "Landlord", 
      property_address = "the property",
      deposit_amount_thb,
      dispute_type = "deposit",
      facts = []
    } = payload;

    if (!caseId) {
      return Response.json({ error: 'caseId required' }, { status: 400 });
    }

    console.log('Generating letter for case:', caseId);

    // Check for existing letter
    const existingDocs = await base44.entities.Document.filter({
      type: 'letter',
      created_by: user.email
    });
    
    const existing = existingDocs.find(doc => 
      doc.label && doc.label.includes(caseId.slice(0, 8))
    );
    
    if (existing) {
      console.log('Letter already exists');
      return Response.json({
        success: true,
        letter_url: existing.file_url
      });
    }

    const factsText = facts.length > 0 ? facts.join('. ') : 'Tenant moved out and returned keys as agreed.';
    
    const userPrompt = `Write a professional bilingual letter for this rental dispute:

Tenant: ${tenant_name}
Landlord: ${landlord_name}
Property: ${property_address}
Issue: ${dispute_type}
${deposit_amount_thb ? `Deposit: ฿${deposit_amount_thb}` : ''}
Facts: ${factsText}

Requirements:
- Professional and polite tone
- 150-200 words in English
- Match each English paragraph with Thai translation
- Keep it concise and clear

IMPORTANT: Return actual Thai Unicode text (สวัสดี ขอบคุณ เช่า), NOT HTML codes or escape sequences.`;

    console.log('Calling LLM...');
    
    const result = await base44.integrations.Core.InvokeLLM({
      prompt: `${LETTER_PROMPT}\n\n${userPrompt}`,
      response_json_schema: {
        type: "object",
        properties: {
          subject_en: { type: "string" },
          subject_th: { type: "string" },
          body_en: { type: "array", items: { type: "string" } },
          body_th: { type: "array", items: { type: "string" } }
        },
        required: ["subject_en", "subject_th", "body_en", "body_th"]
      }
    });

    console.log('LLM responded');

    if (!result?.subject_en || !result?.body_en || !Array.isArray(result.body_en)) {
      throw new Error('Invalid LLM response structure');
    }

    console.log('Letter decoded and validated');
    
    // Log first Thai character to verify encoding
    if (result.subject_th) {
      console.log('Thai subject first char code:', result.subject_th.charCodeAt(0));
    }

    // Generate HTML - NO ENCODING FUNCTIONS, just direct string insertion
    const htmlContent = createHTML(result, {
      caseId,
      property_address,
      deposit_amount_thb
    });

    // Convert to UTF-8 bytes using TextEncoder (proper UTF-8 encoding)
    const encoder = new TextEncoder();
    const utf8Bytes = encoder.encode(htmlContent);
    
    // Create blob with explicit UTF-8 charset
    const blob = new Blob([utf8Bytes], { 
      type: 'text/html; charset=utf-8'
    });
    
    const file = new File([blob], `letter_${caseId}.html`, { 
      type: 'text/html; charset=utf-8'
    });

    const { file_url } = await base44.integrations.Core.UploadFile({ file });

    // Save document
    await base44.entities.Document.create({
      type: 'letter',
      file_url,
      label: `Letter - Case ${caseId.slice(0, 8)}`
    });

    console.log('Letter saved successfully');

    // Update case
    if (!caseId.startsWith('temp-')) {
      const cases = await base44.entities.Case.list();
      const caseData = cases.find(c => c.id === caseId);
      
      if (caseData) {
        await base44.entities.Case.update(caseId, {
          status: 'ready_drafts',
          letters: { letter_url: file_url, letter_data: result }
        });

        await base44.integrations.Core.SendEmail({
          to: user.email,
          subject: user.language === 'th' ? 'จดหมายพร้อมแล้ว' : 'Your Letter is Ready',
          body: `Hi ${user.full_name},\n\nYour letter for case ${caseId.slice(0, 8)} is ready.\n\n— Lease Shield`
        });
      }
    }

    return Response.json({
      success: true,
      caseId,
      letter_url: file_url,
      letter: result
    });

  } catch (error) {
    console.error('Error:', error);
    return Response.json({ 
      error: error.message,
      stack: error.stack 
    }, { status: 500 });
  }
});