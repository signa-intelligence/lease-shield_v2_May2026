import { createClientFromRequest } from 'npm:@base44/sdk@0.7.1';
import Stripe from 'npm:stripe@14.10.0';

const stripe = new Stripe(Deno.env.get('STRIPE_SECRET_KEY'), {
  apiVersion: '2023-10-16',
});

Deno.serve(async (req) => {
  try {
    const signature = req.headers.get('stripe-signature');
    const webhookSecret = Deno.env.get('STRIPE_WEBHOOK_SECRET');
    
    if (!signature || !webhookSecret) {
      return Response.json({ error: 'Missing signature or webhook secret' }, { status: 400 });
    }

    const body = await req.text();
    
    let event;
    try {
      event = stripe.webhooks.constructEvent(body, signature, webhookSecret);
    } catch (err) {
      return Response.json({ error: `Webhook signature verification failed: ${err.message}` }, { status: 400 });
    }

    const base44 = createClientFromRequest(req);

    // Map price IDs to plan tiers
    const planMap = {
      // Monthly prices
      'price_1SM6qtQwoI6NhlUxgDDy2LuJ': { tier: 'lite', interval: 'monthly' },
      'price_1SM6rhQwoI6NhlUxZIN3WekE': { tier: 'protect', interval: 'monthly' },
      'price_1SM6t9QwoI6NhlUxy5Pl7Rrq': { tier: 'secure', interval: 'monthly' },
      
      // Annual prices
      'price_1SNqjfQwoI6NhlUxk9LwivBm': { tier: 'lite', interval: 'annual' },
      'price_1SNqkMQwoI6NhlUxHb2VADjs': { tier: 'protect', interval: 'annual' },
      'price_1SNqkxQwoI6NhlUx09mj0Lur': { tier: 'secure', interval: 'annual' }
    };

    // Map storage addon price IDs
    const storageAddonMap = {
      'price_1StorageAddon5GB': { sizeGb: 5, priceMonthly: 99 },
      'price_1StorageAddon10GB': { sizeGb: 10, priceMonthly: 179 },
      'price_1StorageAddon25GB': { sizeGb: 25, priceMonthly: 399 }
    };

    // Handle different event types
    switch (event.type) {
      case 'invoice.payment_succeeded': {
        const invoice = event.data.object;
        const customerId = invoice.customer;
        const subscriptionId = invoice.subscription;
        
        if (subscriptionId) {
          const subscription = await stripe.subscriptions.retrieve(subscriptionId);
          const priceId = subscription.items.data[0]?.price?.id;
          const metadata = subscription.metadata || {};
          
          // Find user by Stripe customer ID
          const users = await base44.asServiceRole.entities.User.list();
          const user = users.find(u => u.stripe_customer_id === customerId);
          
          if (!user) {
            console.log('User not found for customer:', customerId);
            break;
          }

          // Check if this is a storage addon
          if (metadata.type === 'storage_addon' && storageAddonMap[priceId]) {
            const addonInfo = storageAddonMap[priceId];
            const renewsAt = new Date(subscription.current_period_end * 1000).toISOString();
            
            // Create or update storage addon
            const existingAddons = await base44.asServiceRole.entities.StorageAddon.filter({
              user_email: user.email,
              stripe_subscription_id: subscriptionId
            });

            if (existingAddons.length === 0) {
              await base44.asServiceRole.entities.StorageAddon.create({
                user_email: user.email,
                addon_size_gb: addonInfo.sizeGb,
                price_monthly: addonInfo.priceMonthly,
                stripe_subscription_id: subscriptionId,
                status: 'active',
                renews_at: renewsAt
              });
            } else {
              await base44.asServiceRole.entities.StorageAddon.update(existingAddons[0].id, {
                status: 'active',
                renews_at: renewsAt
              });
            }

            // Send notification email
            const language = user.language || 'en';
            const subject = language === 'th' ? 'พื้นที่จัดเก็บเพิ่มเติมของคุณพร้อมใช้งาน' : 'Your Additional Storage is Active';
            const body = language === 'th' ? 
              `สวัสดี ${user.full_name},\n\nพื้นที่จัดเก็บเพิ่มเติม +${addonInfo.sizeGb}GB ของคุณเปิดใช้งานแล้ว\n\n— ทีม Lease Shield` :
              `Hi ${user.full_name},\n\nYour +${addonInfo.sizeGb}GB storage add-on is now active.\n\n— The Lease Shield Team`;

            await base44.asServiceRole.integrations.Core.SendEmail({
              to: user.email,
              subject,
              body
            });
          } else {
            // Handle regular plan subscription
            const planInfo = planMap[priceId];
            
            if (planInfo) {
              const renewsAt = new Date(subscription.current_period_end * 1000).toISOString();
              
              const updateData = {
                subscription_status: 'active',
                plan_tier: planInfo.tier,
                billing_interval: planInfo.interval,
                plan_renews_at: renewsAt
              };
              
              if (planInfo.tier === 'lite') {
                updateData.scans_this_month = 0;
                const resetDate = new Date(subscription.current_period_end * 1000);
                updateData.scan_reset_date = resetDate.toISOString().split('T')[0];
              }
              
              await base44.asServiceRole.entities.User.update(user.id, updateData);

              const language = user.language || 'en';
              const billingText = planInfo.interval === 'annual' ? 
                (language === 'th' ? 'รายปี' : 'Annual') : 
                (language === 'th' ? 'รายเดือน' : 'Monthly');
              
              const subject = language === 'th' ? 'แพ็กเกจ Lease Shield ของคุณเปิดใช้งานแล้ว' : 'Your Lease Shield Plan is Active';
              const body = language === 'th' ? 
                `สวัสดี ${user.full_name},\n\nแพ็กเกจ ${planInfo.tier.toUpperCase()} (${billingText}) ของคุณเปิดใช้งานแล้ว\n\n— ทีม Lease Shield` :
                `Hi ${user.full_name},\n\nYour Lease Shield ${planInfo.tier.toUpperCase()} plan (${billingText}) is now active.\n\n— The Lease Shield Team`;

              await base44.asServiceRole.integrations.Core.SendEmail({
                to: user.email,
                subject,
                body
              });
            }
          }
        }
        break;
      }

      case 'customer.subscription.updated': {
        const subscription = event.data.object;
        const customerId = subscription.customer;
        const priceId = subscription.items.data[0]?.price?.id;
        const metadata = subscription.metadata || {};
        
        const users = await base44.asServiceRole.entities.User.list();
        const user = users.find(u => u.stripe_customer_id === customerId);
        
        if (!user) break;

        // Handle storage addon updates
        if (metadata.type === 'storage_addon' && storageAddonMap[priceId]) {
          const existingAddons = await base44.asServiceRole.entities.StorageAddon.filter({
            user_email: user.email,
            stripe_subscription_id: subscription.id
          });

          if (existingAddons.length > 0) {
            const status = subscription.status === 'active' ? 'active' : 
                         subscription.status === 'canceled' ? 'cancelled' : 'expired';
            const renewsAt = new Date(subscription.current_period_end * 1000).toISOString();

            await base44.asServiceRole.entities.StorageAddon.update(existingAddons[0].id, {
              status,
              renews_at: renewsAt
            });
          }
        } else {
          // Handle regular plan updates
          const planInfo = planMap[priceId];
          
          if (planInfo) {
            const renewsAt = new Date(subscription.current_period_end * 1000).toISOString();
            const status = subscription.status === 'active' ? 'active' : subscription.status === 'canceled' ? 'cancelled' : 'none';
            
            const updateData = {
              subscription_status: status,
              plan_tier: status === 'active' ? planInfo.tier : 'free',
              billing_interval: status === 'active' ? planInfo.interval : null,
              plan_renews_at: renewsAt
            };
            
            if (status === 'active' && planInfo.tier === 'lite') {
              updateData.scans_this_month = 0;
              const resetDate = new Date(subscription.current_period_end * 1000);
              updateData.scan_reset_date = resetDate.toISOString().split('T')[0];
            }
            
            await base44.asServiceRole.entities.User.update(user.id, updateData);
          }
        }
        break;
      }

      case 'customer.subscription.deleted': {
        const subscription = event.data.object;
        const customerId = subscription.customer;
        const metadata = subscription.metadata || {};
        
        const users = await base44.asServiceRole.entities.User.list();
        const user = users.find(u => u.stripe_customer_id === customerId);
        
        if (!user) break;

        // Handle storage addon cancellation
        if (metadata.type === 'storage_addon') {
          const existingAddons = await base44.asServiceRole.entities.StorageAddon.filter({
            user_email: user.email,
            stripe_subscription_id: subscription.id
          });

          if (existingAddons.length > 0) {
            await base44.asServiceRole.entities.StorageAddon.update(existingAddons[0].id, {
              status: 'cancelled'
            });
          }
        }
        break;
      }

      case 'checkout.session.completed': {
        const session = event.data.object;
        const customerId = session.customer;
        const metadata = session.metadata || {};
        
        // Handle case payment (Resolve service)
        if (metadata.case_id) {
          const caseId = metadata.case_id;
          
          await base44.asServiceRole.entities.Payment.create({
            type: 'case',
            amount: session.amount_total / 100,
            currency: 'THB',
            provider: 'stripe',
            status: 'paid',
            external_id: session.id
          });

          await base44.asServiceRole.entities.Case.update(caseId, {
            status: 'active'
          });

          const users = await base44.asServiceRole.entities.User.list();
          const user = users.find(u => u.stripe_customer_id === customerId);

          if (user) {
            const language = user.language || 'en';
            const subject = language === 'th' ? 'เคสของคุณเริ่มดำเนินการแล้ว' : 'Your Resolve Case Has Started';
            const body = language === 'th' ?
              `เคส Resolve ของคุณเริ่มดำเนินการแล้ว\nทีมงานจะติดต่อคุณภายใน 24-48 ชั่วโมง\n\n— Lease Shield` :
              `Your Resolve case has started.\nOur team will contact you within 24-48 hours.\n\n— Lease Shield`;

            await base44.asServiceRole.integrations.Core.SendEmail({
              to: user.email,
              subject,
              body
            });
          }

          await base44.asServiceRole.integrations.Core.SendEmail({
            to: 'ops@leaseshield.asia',
            subject: 'New Resolve Case Payment Confirmed',
            body: `Case ${caseId} payment confirmed. Amount: ฿${session.amount_total / 100}\n\nPlease review and assign.`
          });
        }
        break;
      }

      case 'invoice.payment_failed': {
        const invoice = event.data.object;
        const customerId = invoice.customer;
        
        const users = await base44.asServiceRole.entities.User.list();
        const user = users.find(u => u.stripe_customer_id === customerId);
        
        if (user) {
          const language = user.language || 'en';
          const subject = language === 'th' ? 'การชำระเงินล้มเหลว - ต้องดำเนินการ' : 'Payment Failed - Action Required';
          const body = language === 'th' ?
            'การชำระเงินล่าสุดของคุณล้มเหลว กรุณาอัปเดตวิธีการชำระเงินเพื่อดำเนินการสมัครสมาชิกต่อ' :
            'Your recent payment failed. Please update your payment method to continue your subscription.';

          await base44.asServiceRole.integrations.Core.SendEmail({
            to: user.email,
            subject,
            body
          });
        }
        break;
      }
    }

    return Response.json({ received: true });
  } catch (error) {
    console.error('Webhook error:', error);
    return Response.json({ error: error.message }, { status: 500 });
  }
});