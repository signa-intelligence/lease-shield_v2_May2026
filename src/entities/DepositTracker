{
  "name": "DepositTracker",
  "type": "object",
  "properties": {
    "deposit_amount": {
      "type": "number",
      "description": "Amount of security deposit"
    },
    "deposit_paid_date": {
      "type": "string",
      "format": "date",
      "description": "When deposit was paid"
    },
    "expected_return_date": {
      "type": "string",
      "format": "date",
      "description": "Expected return date"
    },
    "status": {
      "type": "string",
      "enum": [
        "tracking",
        "returned",
        "dispute"
      ],
      "default": "tracking"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "property_address": {
      "type": "string",
      "description": "Property address"
    },
    "rent_amount": {
      "type": "number",
      "description": "Monthly rent amount"
    },
    "rent_due_day": {
      "type": "integer",
      "description": "Day of month rent is due (1-31)",
      "minimum": 1,
      "maximum": 31
    },
    "rent_alerts_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Enable automated rent reminders"
    },
    "rent_alert_days_before": {
      "type": "integer",
      "default": 3,
      "description": "Days before due date to send reminder",
      "minimum": 1,
      "maximum": 14
    }
  },
  "required": [
    "deposit_amount",
    "deposit_paid_date",
    "expected_return_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": {
          "$ne": "guest"
        }
      }
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}