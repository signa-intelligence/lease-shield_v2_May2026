{
  "name": "Payment",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "subscription",
        "case",
        "addon"
      ],
      "description": "Payment type"
    },
    "currency": {
      "type": "string",
      "default": "THB"
    },
    "amount": {
      "type": "number",
      "description": "Payment amount"
    },
    "provider": {
      "type": "string",
      "enum": [
        "stripe",
        "xendit"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed"
      ],
      "default": "pending"
    },
    "external_id": {
      "type": "string",
      "description": "External payment provider ID"
    }
  },
  "required": [
    "type",
    "amount",
    "provider"
  ]
}