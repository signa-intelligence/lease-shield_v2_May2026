{
  "name": "RiskTaxonomy",
  "type": "object",
  "properties": {
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "taxonomy": {
      "type": "object"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "version",
    "taxonomy"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}