{
  "name": "LisaConversation",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User's email for conversation ownership"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "language": {
            "type": "string"
          }
        }
      },
      "description": "Array of conversation messages (capped at 100)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this is the current active conversation"
    }
  },
  "required": [
    "user_email",
    "messages"
  ],
  "rls": {
    "create": true,
    "read": {
      "user_email": "{{user.email}}"
    },
    "update": {
      "user_email": "{{user.email}}"
    },
    "delete": {
      "user_email": "{{user.email}}"
    }
  }
}