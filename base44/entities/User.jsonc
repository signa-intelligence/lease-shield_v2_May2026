{
  "name": "User",
  "type": "object",
  "properties": {
    "phone": {
      "type": "string",
      "description": "Phone number"
    },
    "country": {
      "type": "string",
      "description": "Country"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "th"
      ],
      "default": "en"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "none",
        "active",
        "cancelled"
      ],
      "default": "none"
    },
    "plan_tier": {
      "type": "string",
      "enum": [
        "free",
        "lite",
        "protect",
        "secure"
      ],
      "default": "free"
    },
    "plan_renews_at": {
      "type": "string",
      "format": "date-time",
      "description": "Plan renewal date"
    },
    "credits_reset_at": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "ISO date when the user's plan credits next reset"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID"
    },
    "line_messaging_token": {
      "type": "string",
      "description": "LINE Messaging API user ID"
    },
    "email_notifications": {
      "type": "boolean",
      "default": true,
      "description": "Enable email notifications"
    },
    "line_notifications": {
      "type": "boolean",
      "default": false,
      "description": "Enable LINE notifications"
    },
    "free_scans_used": {
      "type": "integer",
      "default": 0,
      "description": "Number of free scans used (Explorer plan)"
    },
    "free_scan_eligible": {
      "type": "boolean",
      "default": true,
      "description": "Whether user is eligible to use their free scan"
    },
    "onboarding_lease_done": {
      "type": "boolean",
      "default": false,
      "description": "Permanent flag: user has uploaded a lease at least once"
    },
    "onboarding_deposit_done": {
      "type": "boolean",
      "default": false,
      "description": "Permanent flag: user has tracked a deposit at least once"
    },
    "onboarding_maintenance_done": {
      "type": "boolean",
      "default": false,
      "description": "Permanent flag: user has reported a maintenance issue at least once"
    },
    "onboarding_evidence_done": {
      "type": "boolean",
      "default": false,
      "description": "Permanent flag: user has uploaded evidence at least once"
    },
    "onboarding_profile_done": {
      "type": "boolean",
      "default": false,
      "description": "Permanent flag: user has completed their profile at least once"
    },
    "onboarding_notifications_done": {
      "type": "boolean",
      "default": false,
      "description": "Permanent flag: user has enabled notifications at least once"
    }
  },
  "required": []
}